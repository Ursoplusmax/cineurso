<addon id="plugin.video.cineurso" version="1.0.0" name="Cine Urso" provider-name="ursocine">
  <requires>
    <import addon="script.module.requests" />
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="script.module.simplejson" version="3.19.1"/> 
  </requires>

  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.service" library="service.py" start="login" />

  <extension point="xbmc.addon.metadata">
    <description lang="pt_BR">Addon brasileiro para streaming de filmes e séries. Somos apenas uma biblioteca de itens.</description>
    <disclaimer lang="pt_BR">OBRIGADO PELA PREFERÊNCIA S2</disclaimer>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/seu-usuario/cine-urso</source>
    <email>cineroom.ofc@gmail.com</email>
    <assets>
      <po>resources/language</po>
      <icon>resources/images/icon.png</icon>
      <fanart>resources/images/fanart.jpg</fanart>
      <screenshot>resources/images/screenshot-1.jpg</screenshot>
      <screenshot>resources/images/screenshot-2.jpg</screenshot>
      <screenshot>resources/images/screenshot-3.jpg</screenshot>
    </assets>
  </extension>
</addon>
