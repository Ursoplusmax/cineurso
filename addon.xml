<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mediacenter" name="Media Center" version="2.0.0" provider-name="MediaCenter">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    
    <extension point="xbmc.service" library="service.py" />
    
    <extension point="xbmc.addon.metadata">
        <summary>Media Center HD</summary>
        <description>Acesse filmes, séries e animes do seu HD 2TB. Suporte completo ao Drive D com interface otimizada para Kodi.</description>
        <language>pt</language>
        <platform>all</platform>
        <license>MIT</license>
        <website>https://github.com/seu-usuario/mediacenter</website>
        <source>https://github.com/seu-usuario/mediacenter</source>
        
        <assets>
            <icon>resources/images/icon.png</icon>
            <fanart>resources/images/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
