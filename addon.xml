<!-- D:\MediaCenter\Kodi\Addon\addon.xml -->
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.mediacenter" name="Media Center" version="1.0.0" provider-name="MediaCenter">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="plugin.video.youtube" version="6.8.0" optional="true"/>
    </requires>
    
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    
    <extension point="xbmc.service" library="service.py" />
    
    <extension point="xbmc.addon.metadata">
        <summary>Media Center HD</summary>
        <description>Acesse sua biblioteca personalizada de Filmes, Séries e Animes do HD 2TB</description>
        <disclaimer>Require Media Center configurado no Drive D</disclaimer>
        <language>pt</language>
        <platform>all</platform>
        <license>MIT</license>
        <website>https://github.com</website>
        <source>https://github.com</source>
        <email>seu@email.com</email>
        
        <assets>
            <icon>resources/images/icon.png</icon>
            <fanart>resources/images/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
